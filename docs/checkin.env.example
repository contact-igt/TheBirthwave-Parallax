# Environment for the SEPARATE check-in Vercel project (checkin.thebirthwave.in).
# Paste the non-secret block into Project -> Settings -> Environment Variables (Production).
# Secrets are listed as placeholders only: set them in the dashboard, never in Git.

# --- non-secret, safe to paste now -------------------------------------------------
CLINIC_APP=checkin
CHECKIN_ORIGIN=https://checkin.thebirthwave.in
CLINIC_LOCATION_ID=main

# --- leave UNSET until the clinic approves storage and signs off -------------------
# With these unset the app answers 503 on submit and never shows a success page.
# REGISTRATION_ENABLED=true
# REGISTRATION_STORE_URL=https://<approved-backend>/intake
# REGISTRATION_STATUS_URL=https://<approved-backend>/status
# REGISTRATION_STORE_ALLOWED_HOSTS=<approved-backend-host>
# REGISTRATION_STORE_TOKEN=<secret>

# --- staff queue console (off unless all are set) ----------------------------------
# STAFF_CONSOLE_ENABLED=true
# STAFF_SESSION_SECRET=<32+ random characters, secret>
# STAFF_ACCOUNTS=[{"username":"reception1","passwordHash":"scrypt$...","role":"reception"}]
# QUEUE_ADMIN_URL=https://<approved-backend>/admin
# QUEUE_ADMIN_TOKEN=<secret>
